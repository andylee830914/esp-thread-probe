+struct netif * FindEspOpenThreadNetif()
+{
+    esp_netif_t * otNetif = esp_openthread_get_netif();
+    if (otNetif == nullptr)
+    {
+        return nullptr;
+    }
+
+    const int netifIndex = esp_netif_get_netif_impl_index(otNetif);
+    if (netifIndex <= 0)
+    {
+        return nullptr;
+    }
+
+    return netif_get_by_index(static_cast<u8_t>(netifIndex));
+}
+#endif // CHIP_LWIP_HAS_ESP_OPENTHREAD_NETIF
+
+struct netif * FindNetifForUniqueLocalDestination(const ip_addr_t & destAddr)
+{
+    if (IP_GET_TYPE(&destAddr) != IPADDR_TYPE_V6)
+    {
+        return nullptr;
+    }
+
+    const ip6_addr_t * dest = ip_2_ip6(&destAddr);
+    if (!ip6_addr_isuniquelocal(dest))
+    {
+        return nullptr;
+    }
+
+    struct netif * candidate       = nullptr;
+    struct netif * threadCandidate = nullptr;
+    NETIF_FOREACH(candidate)
+    {
+        if (!netif_is_up(candidate) || !netif_is_link_up(candidate))
+        {
+            continue;
+        }
+
+        if (candidate->name[0] == 't' && candidate->name[1] == 'h')
+        {
+            threadCandidate = candidate;
+        }
+
+        for (u8_t i = 0; i < LWIP_IPV6_NUM_ADDRESSES; i++)
+        {
+            const ip6_addr_t * localAddr = netif_ip6_addr(candidate, i);
+            if (ip6_addr_isvalid(netif_ip6_addr_state(candidate, i)) && ip6_addr_isuniquelocal(localAddr) &&
+                ip6_addr_net_eq(dest, localAddr))
+            {
+                return candidate;
+            }
+        }
+    }
+
+#if CHIP_LWIP_HAS_ESP_OPENTHREAD_NETIF
+    struct netif * espOtNetif = FindEspOpenThreadNetif();
+    if (espOtNetif != nullptr)
+    {
+        return espOtNetif;
+    }
+#endif // CHIP_LWIP_HAS_ESP_OPENTHREAD_NETIF
+
+    return threadCandidate;
+}
